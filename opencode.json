{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "Remove-Item*": "deny",
      "rm *": "deny",
      "del *": "deny",
      "mysql*DROP*": "deny"
    }
  }
}

@model SistemNilaiAkademik.Models.Siswa

@{
    ViewData["Title"] = "Ubah Siswa";
}

<div class="page-heading">
    <h1>Ubah Siswa</h1>
    <p>Perbarui data siswa sesuai kebutuhan.</p>
</div>

<div class="card card-sia">
    <div class="card-header">Form Siswa</div>
    <div class="card-body">
        <form asp-action="Edit" method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
            <div class="col-md-6">
                <label asp-for="Nis" class="form-label">NIS</label>
                <input asp-for="Nis" class="form-control" />
                <span asp-validation-for="Nis" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Nisn" class="form-label">NISN</label>
                <input asp-for="Nisn" class="form-control" />
                <span asp-validation-for="Nisn" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="NamaSiswa" class="form-label">Nama Siswa</label>
                <input asp-for="NamaSiswa" class="form-control" />
                <span asp-validation-for="NamaSiswa" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="JenisKelamin" class="form-label">Jenis Kelamin</label>
                <select asp-for="JenisKelamin" class="form-select">
                    <option value="">-- Pilih --</option>
                    <option value="Laki-laki">Laki-laki</option>
                    <option value="Perempuan">Perempuan</option>
                </select>
                <span asp-validation-for="JenisKelamin" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TanggalLahir" class="form-label">Tanggal Lahir</label>
                <input asp-for="TanggalLahir" class="form-control" />
                <span asp-validation-for="TanggalLahir" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="IdKelas" class="form-label">Kelas</label>
                <select asp-for="IdKelas" class="form-select" asp-items="ViewBag.IdKelas">
                    <option value="">-- Pilih Kelas --</option>
                </select>
                <span asp-validation-for="IdKelas" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Alamat" class="form-label">Alamat</label>
                <textarea asp-for="Alamat" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Alamat" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="Aktif">Aktif</option>
                    <option value="Nonaktif">Nonaktif</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Kembali</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model SistemNilaiAkademik.Models.PeriodeAkademik

@{
    ViewData["Title"] = "Detail Periode Akademik";
}

<div class="page-heading">
    <h1>Detail Periode Akademik</h1>
    <p>Informasi lengkap periode akademik.</p>
</div>

<div class="card card-sia">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Model.NamaPeriode</span>
        <span class="badge-sia @(Model.Status == "Aktif" ? string.Empty : "badge-nonaktif")">@Model.Status</span>
    </div>
    <div class="card-body">
        <dl class="row detail-sia mb-0">
            <dt class="col-sm-3">Nama Periode</dt>
            <dd class="col-sm-9">@Model.NamaPeriode</dd>
            <dt class="col-sm-3">Tahun Ajaran</dt>
            <dd class="col-sm-9">@Model.TahunAjaran</dd>
            <dt class="col-sm-3">Semester</dt>
            <dd class="col-sm-9">@Model.Semester</dd>
            <dt class="col-sm-3">Tanggal Mulai</dt>
            <dd class="col-sm-9">@Model.TanggalMulai.ToString("dd-MM-yyyy")</dd>
            <dt class="col-sm-3">Tanggal Selesai</dt>
            <dd class="col-sm-9">@Model.TanggalSelesai.ToString("dd-MM-yyyy")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent border-0 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Kembali</a>
    </div>
</div>

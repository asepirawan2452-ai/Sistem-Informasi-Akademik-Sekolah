@model SistemNilaiAkademik.Models.PeriodeAkademik

@{
    ViewData["Title"] = "Nonaktifkan Periode Akademik";
}

<div class="page-heading">
    <h1>Nonaktifkan Periode Akademik</h1>
    <p>Data tidak dihapus, hanya diubah menjadi Nonaktif.</p>
</div>

<div class="card card-sia">
    <div class="card-header">Konfirmasi</div>
    <div class="card-body">
        <p class="mb-3">Nonaktifkan periode <strong>@Model.NamaPeriode</strong>?</p>
        <dl class="row detail-sia mb-3">
            <dt class="col-sm-3">Tahun Ajaran</dt>
            <dd class="col-sm-9">@Model.TahunAjaran</dd>
            <dt class="col-sm-3">Semester</dt>
            <dd class="col-sm-9">@Model.Semester</dd>
            <dt class="col-sm-3">Status Saat Ini</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Nonaktifkan</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Kembali</a>
        </form>
    </div>
</div>

@model IEnumerable<SistemNilaiAkademik.Models.PeriodeAkademik>

@{
    ViewData["Title"] = "Periode Akademik";
}

<div class="page-heading">
    <h1>Periode Akademik</h1>
    <p>Kelola tahun ajaran dan semester aktif.</p>
</div>

<div class="card card-sia">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Daftar Periode Akademik</span>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Tambah Periode</a>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">Belum ada data periode akademik.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sia mb-0">
                    <thead>
                        <tr>
                            <th>Nama Periode</th>
                            <th>Tahun Ajaran</th>
                            <th>Semester</th>
                            <th>Tanggal Mulai</th>
                            <th>Tanggal Selesai</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.NamaPeriode</td>
                                <td>@item.TahunAjaran</td>
                                <td>@item.Semester</td>
                                <td>@item.TanggalMulai.ToString("dd-MM-yyyy")</td>
                                <td>@item.TanggalSelesai.ToString("dd-MM-yyyy")</td>
                                <td><span class="badge-sia @(item.Status == "Aktif" ? string.Empty : "badge-nonaktif")">@item.Status</span></td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Detail</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Ubah</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Nonaktifkan</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

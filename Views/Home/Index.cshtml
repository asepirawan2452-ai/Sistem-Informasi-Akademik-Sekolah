@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-heading">
    <h1>Selamat datang di SIAKAD</h1>
    <p>Ringkasan dan akses cepat pengelolaan data akademik.</p>
</div>

<div class="card card-sia hero-card mb-4">
    <div class="card-body">
        <h1>Sistem Informasi Nilai Akademik</h1>
        <p>
            Kelola data master siswa, guru, mata pelajaran, kelas, periode akademik, dan jurusan
            dalam satu tempat. Modul transaksi nilai tersedia pada tahap berikutnya.
        </p>
        <span class="badge bg-light text-dark">Tahap 2 - Data Master Siap Digunakan</span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card card-sia h-100">
            <div class="card-body">
                <div class="metric-value">15</div>
                <div class="metric-label">Entitas hasil ERD revisi</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card card-sia h-100">
            <div class="card-body">
                <div class="metric-value">6</div>
                <div class="metric-label">Modul data master</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card card-sia h-100">
            <div class="card-body">
                <div class="metric-value">30/30/40</div>
                <div class="metric-label">Bobot harian/UTS/UAS</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card card-sia h-100">
            <div class="card-body">
                <div class="metric-value">A-B-C-D</div>
                <div class="metric-label">Konversi nilai huruf</div>
            </div>
        </div>
    </div>
</div>

<div class="card card-sia">
    <div class="card-header">Akses cepat data master</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6 col-xl-4">
                <a class="quick-link" asp-controller="Siswa" asp-action="Index">
                    <span class="quick-mark">S</span><span>Data Siswa</span>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="quick-link" asp-controller="Guru" asp-action="Index">
                    <span class="quick-mark">G</span><span>Data Guru</span>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="quick-link" asp-controller="Mapel" asp-action="Index">
                    <span class="quick-mark">M</span><span>Mata Pelajaran</span>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="quick-link" asp-controller="Kelas" asp-action="Index">
                    <span class="quick-mark">K</span><span>Data Kelas</span>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="quick-link" asp-controller="Periode" asp-action="Index">
                    <span class="quick-mark">P</span><span>Periode Akademik</span>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="quick-link" asp-controller="Jurusan" asp-action="Index">
                    <span class="quick-mark">J</span><span>Jurusan</span>
                </a>
            </div>
        </div>
    </div>
</div>

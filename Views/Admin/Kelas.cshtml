@model IEnumerable<SistemInformasiNilaiAkademik.Models.Kelas>
@{
    ViewData["Title"] = "Master Data Kelas";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Data Kelas</h3>
        <p class="text-muted small mb-0">Kelola rombongan belajar, tingkat, konsentrasi kejuruan, dan penetapan wali kelas.</p>
    </div>
    <a asp-action="CreateKelas" class="btn btn-nev-primary">
        + Tambah Kelas
    </a>
</div>

<div class="nev-card">
    <div class="table-responsive">
        <table class="table-nev">
            <thead>
                <tr>
                    <th>Nama Kelas</th>
                    <th>Tingkat</th>
                    <th>Konsentrasi Keahlian</th>
                    <th>Wali Kelas</th>
                    <th>Jumlah Siswa</th>
                    <th>Status</th>
                    <th class="text-end">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td class="fw-bold fs-6">@k.NamaKelas</td>
                        <td>
                            <span class="badge bg-secondary">Tingkat @k.Tingkat</span>
                        </td>
                        <td>@k.Jurusan?.Nama (@k.Jurusan?.Kode)</td>
                        <td>
                            @if (k.WaliKelas != null)
                            {
                                <div class="fw-semibold text-success">@k.WaliKelas.Nama</div>
                                <div class="text-muted small">NIP: @k.WaliKelas.NipNrg</div>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Belum ada wali</span>
                            }
                        </td>
                        <td>
                            <span class="badge" style="background-color: var(--primary-light); color: var(--primary-color);">
                                @k.SiswaList.Count Siswa
                            </span>
                        </td>
                        <td>
                            <span class="badge-pill-status @(k.Status == "Aktif" ? "status-aktif" : "status-nonaktif")">
                                @k.Status
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditKelas" asp-route-id="@k.IdKelas" class="btn btn-sm btn-nev-edit py-1 px-2">Edit</a>
                                <form asp-action="DeleteKelas" asp-route-id="@k.IdKelas" method="post" class="d-inline" onsubmit="return confirm('Hapus kelas @k.NamaKelas?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-nev-danger py-1 px-2">Hapus</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

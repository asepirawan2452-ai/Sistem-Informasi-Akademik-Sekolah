@model SistemInformasiNilaiAkademik.ViewModels.GuruFormViewModel
@{
    ViewData["Title"] = "Tambah Guru";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="nev-card">
            <div class="nev-card-header">
                <div>
                    <h4 class="nev-card-title">Tambah Guru Baru</h4>
                    <div class="text-muted small">Registrasi guru beserta akun login sistem</div>
                </div>
                <a asp-action="Guru" class="btn btn-sm btn-nev-outline">&larr; Kembali</a>
            </div>

            <form asp-action="CreateGuru" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-nev alert-nev-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NipNrg" class="form-label-nev">NIP / NRG *</label>
                        <input asp-for="NipNrg" class="form-control form-control-nev" placeholder="Masukkan NIP atau NRG unik" required />
                        <span asp-validation-for="NipNrg" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Nama" class="form-label-nev">Nama Lengkap Guru (beserta gelar) *</label>
                        <input asp-for="Nama" class="form-control form-control-nev" placeholder="Contoh: Budi Santoso, S.Kom." required />
                        <span asp-validation-for="Nama" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded-3" style="background-color: #f8fafc; border: 1px dashed var(--border-color);">
                            <div class="fw-bold mb-2">Buat Akun Pengguna Sekaligus</div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label-nev">Username Login</label>
                                    <input asp-for="Username" class="form-control form-control-nev" placeholder="Contoh: budi.santoso" required />
                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label-nev">Kata Sandi Awal</label>
                                    <div class="password-field-wrapper">
                                        <input asp-for="Password" type="password" class="form-control form-control-nev" placeholder="Minimal 6 karakter" autocomplete="new-password" required />
                                        <button class="password-toggle-button" type="button" data-password-toggle aria-label="Tampilkan kata sandi" aria-pressed="false">
                                            <svg data-eye-visible viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                                            <svg data-eye-hidden viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /><path d="m3 3 18 18" /></svg>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label-nev">Status Guru</label>
                        <select asp-for="Status" class="form-select form-select-nev">
                            <option value="Aktif">Aktif</option>
                            <option value="Nonaktif">Nonaktif</option>
                        </select>
                    </div>

                    <div class="col-12 mt-4 pt-2 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Guru" class="btn btn-nev-outline">Batal</a>
                        <button type="submit" class="btn btn-nev-primary">Simpan Guru</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

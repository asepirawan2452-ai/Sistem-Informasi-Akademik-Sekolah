@model SistemInformasiNilaiAkademik.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Atur Ulang Kata Sandi";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="nev-card">
            <div class="nev-card-header">
                <div>
                    <h4 class="nev-card-title">Atur Ulang Kata Sandi</h4>
                    <div class="text-muted small">Akun: <strong>@Model.Nama</strong> (<code>@Model.Username</code>)</div>
                </div>
                <a asp-action="PemulihanKataSandi" class="btn btn-sm btn-nev-outline">&larr; Kembali</a>
            </div>

            <form asp-action="ResetPasswordPengguna" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="IdPengguna" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-nev alert-nev-danger"></div>

                <div class="mb-3">
                    <label asp-for="KataSandiBaru" class="form-label-nev">Kata Sandi Baru *</label>
                    <div class="password-field-wrapper">
                        <input asp-for="KataSandiBaru" type="password" class="form-control form-control-nev" autocomplete="new-password" required />
                        <button class="password-toggle-button" type="button" data-password-toggle aria-label="Tampilkan kata sandi" aria-pressed="false">
                            <svg data-eye-visible viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg data-eye-hidden viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /><path d="m3 3 18 18" /></svg>
                        </button>
                    </div>
                    <span asp-validation-for="KataSandiBaru" class="text-danger small"></span>
                    <div class="form-text">Gunakan setidaknya 8 karakter.</div>
                </div>
                <div class="mb-4">
                    <label asp-for="KonfirmasiKataSandi" class="form-label-nev">Konfirmasi Kata Sandi *</label>
                    <div class="password-field-wrapper">
                        <input asp-for="KonfirmasiKataSandi" type="password" class="form-control form-control-nev" autocomplete="new-password" required />
                        <button class="password-toggle-button" type="button" data-password-toggle aria-label="Tampilkan kata sandi" aria-pressed="false">
                            <svg data-eye-visible viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg data-eye-hidden viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /><path d="m3 3 18 18" /></svg>
                        </button>
                    </div>
                    <span asp-validation-for="KonfirmasiKataSandi" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-action="PemulihanKataSandi" class="btn btn-nev-outline">Batal</a>
                    <button type="submit" class="btn btn-nev-primary">Simpan Kata Sandi Baru</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model SistemInformasiNilaiAkademik.ViewModels.GrafikViewModel
@{
    ViewData["Title"] = "Grafik Capaian Kelas";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Grafik Rata-rata Nilai Kelas @Model.NamaKelas</h3>
        <p class="text-muted small mb-0">Visualisasi statistik capaian nilai akhir per mata pelajaran untuk kelas binaan Anda.</p>
    </div>
    <a asp-action="RekapKelas" class="btn btn-nev-outline">&larr; Kembali ke Rekap</a>
</div>

<!-- Summary Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-widget">
            <div class="stat-title">Rata-rata Rombel</div>
            <div class="stat-value">@Model.RataRataKeseluruhan.ToString("0.##")</div>
            <div class="stat-sub">Rerata Seluruh Mata Pelajaran</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-widget">
            <div class="stat-title">Mapel Nilai Tertinggi</div>
            <div class="stat-value fs-4 text-truncate" title="@Model.MapelTertinggi">@Model.MapelTertinggi</div>
            <div class="stat-sub text-success">Rata-rata tertinggi</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-widget">
            <div class="stat-title">Mapel Perlu Evaluasi</div>
            <div class="stat-value fs-4 text-truncate" title="@Model.MapelTerendah">@Model.MapelTerendah</div>
            <div class="stat-sub text-danger">Tindak Lanjut Pembelajaran</div>
        </div>
    </div>
</div>

<!-- Main Bar Chart -->
<div class="nev-card">
    <div class="nev-card-header">
        <div>
            <h5 class="nev-card-title">Diagram Batang Rata-rata Nilai Akhir Mata Pelajaran</h5>
            <div class="text-muted small">Periode: @Model.NamaPeriode &bull; @Model.TotalSiswa Peserta Didik</div>
        </div>
    </div>

    <div class="w-100" style="min-height: 340px;">
        <canvas id="grafikWaliKelasCanvas" height="320"></canvas>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LabelsMapel));
            var values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DataRataRata));
            
            if (window.NevCharts) {
                window.NevCharts.drawBar('grafikWaliKelasCanvas', labels, values);
            }
        });
    </script>
}

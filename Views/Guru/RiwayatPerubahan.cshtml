@model IEnumerable<SistemInformasiNilaiAkademik.Models.LogPerubahanNilai>
@{
    ViewData["Title"] = "Riwayat Audit Perubahan Nilai";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Riwayat Perubahan Nilai</h3>
        <p class="text-muted small mb-0">Semester: <strong>@ViewBag.NamaPeriodeAktif</strong> &bull; Jejak koreksi nilai semester ini beserta waktu, nilai sebelum/sesudah, dan alasan perubahan.</p>
    </div>
</div>

<div class="nev-card">
    <div class="table-responsive">
        <table class="table-nev">
            <thead>
                <tr>
                    <th>Waktu Perubahan</th>
                    <th>Nama Siswa</th>
                    <th>Kelas</th>
                    <th>Mata Pelajaran</th>
                    <th>Komponen</th>
                    <th>Koreksi Nilai</th>
                    <th>Alasan Perubahan</th>
                    <th>Diubah Oleh</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td class="text-muted small">
                            @l.WaktuPerubahan.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td class="fw-bold">@l.Nilai?.Siswa?.NamaSiswa</td>
                        <td>
                            <span class="badge" style="background-color: var(--primary-light); color: var(--primary-color);">
                                @l.Nilai?.Siswa?.Kelas?.NamaKelas
                            </span>
                        </td>
                        <td>@l.Nilai?.Mapel?.NamaMapel</td>
                        <td>
                            <span class="badge bg-secondary">@l.Nilai?.KomponenNilai?.NamaKomponen</span>
                        </td>
                        <td>
                            <span class="text-danger text-decoration-line-through">@l.NilaiLama.ToString("0.##")</span>
                            <span class="mx-1">&rarr;</span>
                            <span class="text-success fw-bold">@l.NilaiBaru.ToString("0.##")</span>
                        </td>
                        <td>
                            <span class="fst-italic text-dark">"@l.Alasan"</span>
                        </td>
                        <td class="small text-muted">@l.Pengguna?.Nama</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Belum ada riwayat perubahan nilai yang tercatat.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

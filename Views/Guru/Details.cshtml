@model SistemNilaiAkademik.Models.Guru

@{
    ViewData["Title"] = "Detail Guru";
}

<div class="page-heading">
    <h1>Detail Guru</h1>
    <p>Informasi lengkap data guru.</p>
</div>

<div class="card card-sia">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Model.Nama</span>
        <span class="badge-sia @(Model.Status == "Aktif" ? string.Empty : "badge-nonaktif")">@Model.Status</span>
    </div>
    <div class="card-body">
        <dl class="row detail-sia mb-0">
            <dt class="col-sm-3">NIP/NRG</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.NipNrg) ? "-" : Model.NipNrg)</dd>
            <dt class="col-sm-3">Nama Guru</dt>
            <dd class="col-sm-9">@Model.Nama</dd>
            <dt class="col-sm-3">Akun</dt>
            <dd class="col-sm-9">@Model.Pengguna.Nama (@Model.Pengguna.Username)</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent border-0 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Kembali</a>
    </div>
</div>

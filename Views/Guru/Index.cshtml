@model IEnumerable<SistemNilaiAkademik.Models.Guru>

@{
    ViewData["Title"] = "Data Guru";
}

<div class="page-heading">
    <h1>Data Guru</h1>
    <p>Kelola data guru dan akun pengguna terkait.</p>
</div>

<div class="card card-sia">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Daftar Guru</span>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Tambah Guru</a>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">Belum ada data guru.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sia mb-0">
                    <thead>
                        <tr>
                            <th>NIP/NRG</th>
                            <th>Nama Guru</th>
                            <th>Akun</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(string.IsNullOrEmpty(item.NipNrg) ? "-" : item.NipNrg)</td>
                                <td class="fw-semibold">@item.Nama</td>
                                <td>@item.Pengguna.Username</td>
                                <td><span class="badge-sia @(item.Status == "Aktif" ? string.Empty : "badge-nonaktif")">@item.Status</span></td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Detail</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Ubah</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Nonaktifkan</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

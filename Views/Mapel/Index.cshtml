@model IEnumerable<SistemNilaiAkademik.Models.Mapel>

@{
    ViewData["Title"] = "Mata Pelajaran";
}

<div class="page-heading">
    <h1>Mata Pelajaran</h1>
    <p>Kelola daftar mata pelajaran umum dan kejuruan.</p>
</div>

<div class="card card-sia">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Daftar Mata Pelajaran</span>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Tambah Mapel</a>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">Belum ada data mata pelajaran.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sia mb-0">
                    <thead>
                        <tr>
                            <th>Kode</th>
                            <th>Nama Mata Pelajaran</th>
                            <th>Kelompok</th>
                            <th>Jurusan</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.KodeMapel</td>
                                <td class="fw-semibold">@item.NamaMapel</td>
                                <td>@item.Kelompok</td>
                                <td>@(item.Jurusan?.Nama ?? "-")</td>
                                <td><span class="badge-sia @(item.Status == "Aktif" ? string.Empty : "badge-nonaktif")">@item.Status</span></td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Detail</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Ubah</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Nonaktifkan</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@model SistemNilaiAkademik.Models.Mapel

@{
    ViewData["Title"] = "Detail Mata Pelajaran";
}

<div class="page-heading">
    <h1>Detail Mata Pelajaran</h1>
    <p>Informasi lengkap mata pelajaran.</p>
</div>

<div class="card card-sia">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Model.NamaMapel</span>
        <span class="badge-sia @(Model.Status == "Aktif" ? string.Empty : "badge-nonaktif")">@Model.Status</span>
    </div>
    <div class="card-body">
        <dl class="row detail-sia mb-0">
            <dt class="col-sm-3">Kode Mapel</dt>
            <dd class="col-sm-9">@Model.KodeMapel</dd>
            <dt class="col-sm-3">Nama Mata Pelajaran</dt>
            <dd class="col-sm-9">@Model.NamaMapel</dd>
            <dt class="col-sm-3">Kelompok</dt>
            <dd class="col-sm-9">@Model.Kelompok</dd>
            <dt class="col-sm-3">Jurusan</dt>
            <dd class="col-sm-9">@(Model.Jurusan?.Nama ?? "-")</dd>
            <dt class="col-sm-3">Deskripsi</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Deskripsi) ? "-" : Model.Deskripsi)</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent border-0 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Ubah</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Kembali</a>
    </div>
</div>

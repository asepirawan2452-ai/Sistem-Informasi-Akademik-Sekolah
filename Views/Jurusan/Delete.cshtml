@model SistemNilaiAkademik.Models.Jurusan

@{
    ViewData["Title"] = "Hapus Jurusan";
}

<div class="page-heading">
    <h1>Hapus Jurusan</h1>
    <p>Jurusan hanya dapat dihapus jika belum digunakan.</p>
</div>

<div class="card card-sia">
    <div class="card-header">Konfirmasi</div>
    <div class="card-body">
        <p class="mb-3">Hapus jurusan <strong>@Model.Nama</strong> (@Model.Kode)?</p>
        <dl class="row detail-sia mb-3">
            <dt class="col-sm-3">Kode</dt>
            <dd class="col-sm-9">@Model.Kode</dd>
            <dt class="col-sm-3">Nama Jurusan</dt>
            <dd class="col-sm-9">@Model.Nama</dd>
        </dl>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Hapus</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Kembali</a>
        </form>
    </div>
</div>

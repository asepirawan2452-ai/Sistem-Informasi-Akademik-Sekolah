@model IEnumerable<SistemNilaiAkademik.Models.Kelas>

@{
    ViewData["Title"] = "Data Kelas";
}

<div class="page-heading">
    <h1>Data Kelas</h1>
    <p>Kelola kelas, jurusan, dan wali kelas.</p>
</div>

<div class="card card-sia">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Daftar Kelas</span>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Tambah Kelas</a>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">Belum ada data kelas.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sia mb-0">
                    <thead>
                        <tr>
                            <th>Nama Kelas</th>
                            <th>Tingkat</th>
                            <th>Jurusan</th>
                            <th>Wali Kelas</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.NamaKelas</td>
                                <td>@item.Tingkat</td>
                                <td>@item.Jurusan.Nama</td>
                                <td>@item.WaliKelas.Nama</td>
                                <td><span class="badge-sia @(item.Status == "Aktif" ? string.Empty : "badge-nonaktif")">@item.Status</span></td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Detail</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Ubah</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Nonaktifkan</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
